# Local setup: npm run setup:owner creates .env.local with private credentials.
# Merge these optional settings without overwriting those credentials.
THALIKA_ROLE=studio
THALIKA_CLOUD=0
APP_ORIGIN=http://localhost:3000
# THALIKA_DATA_DIR=/absolute/private/path/data
# THALIKA_CONFIG_DIR=/absolute/private/path/config
HF_VOXCPM2_URL=http://127.0.0.1:7860
HF_REQUEST_TIMEOUT=3000
HF_INFERENCE_TIMEOUT=300000
VOXCPM_DEVICE=auto
VOXCPM_TIMESTEPS=10
VOXCPM_LOAD_DENOISER=0
# HF_HOME=/absolute/private/path/model-cache
DATA_QUOTA_GB=20
# GEMINI_API_KEY= (optional; or save through authenticated script settings)
# OWNER_PASSWORD_HASH= (from setup:owner)
# SESSION_SECRET= (from setup:owner)
# RUNTIME_TOKEN= (from setup:owner; share ONLY with separate control service)
# CONTROL_PLANE_URL=https://control.example.com/settings

# Separate control service only; never put the provider API key in the GPU image or browser.
# THALIKA_ROLE=control
# THALIKA_CLOUD=1
# APP_ORIGIN=https://control.example.com
# THALIKA_DATA_DIR=/workspace/persistent/control-data
# THALIKA_CONFIG_DIR=/workspace/persistent/control-config
# RUNPOD_API_KEY=
# THALIKA_INSTALLATION_ID=owner1
# RUNPOD_POD_ID= (existing managed Pod; optional)
# ALLOW_GPU_PROVISIONING=0
# RUNPOD_TEMPLATE_ID= (prebuilt GPU template with secret references)
# RUNPOD_NETWORK_VOLUME_ID=
# RUNPOD_DATA_CENTER_ID= (must match the network volume)
# RUNPOD_GPU_TYPES=NVIDIA RTX A5000,NVIDIA GeForce RTX 3090
# IDLE_TIMEOUT_MINUTES=20
# AUTO_STOP_ENABLED=0
# SESSION_BUDGET_USD=2
