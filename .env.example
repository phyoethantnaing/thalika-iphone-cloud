# Local setup: npm run setup:owner creates .env.local with private credentials.
# Merge these optional settings without overwriting those credentials.
THALIKA_CLOUD=0
APP_ORIGIN=http://localhost:3000
# THALIKA_DATA_DIR=/absolute/private/path/data
# THALIKA_CONFIG_DIR=/absolute/private/path/config
HF_VOXCPM2_URL=http://127.0.0.1:7860
HF_REQUEST_TIMEOUT=3000
HF_INFERENCE_TIMEOUT=300000
VOXCPM_DEVICE=auto
VOXCPM_TIMESTEPS=10
VOXCPM_LOAD_DENOISER=0
# HF_HOME=/absolute/private/path/model-cache
DATA_QUOTA_GB=20
# GEMINI_API_KEY= (optional; or save through authenticated script settings)
# OWNER_PASSWORD_HASH= (from setup:owner)
# SESSION_SECRET= (from setup:owner)
# RUNTIME_TOKEN= (from setup:owner; loopback launcher only)

# Kaggle: scripts/kaggle-start.py sets every value above from Kaggle Secrets.
# Optional GPU overrides: VOXCPM_DTYPE=float32|float16|bfloat16  VOXCPM_OPTIMIZE=0|1
